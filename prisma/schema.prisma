generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum Role {
  MEMBER
  CONSULTANT
  ADMIN
}

enum VerificationStatus {
  PENDING
  VERIFIED
  FAILED
}

enum ProfileStatus {
  DRAFT
  PENDING_APPROVAL
  PUBLISHED
  HIDDEN
}

enum AuthoredBy {
  SELF
  CONCIERGE
}

enum ProfilePath {
  BUILD_OWN
  CONCIERGE
}

enum ModerationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AppointmentKind {
  SCHEDULED
  LIVE
}

enum AppointmentStatus {
  REQUESTED
  CONFIRMED
  DECLINED
  CANCELLED
  RESCHEDULE_PROPOSED
  COMPLETED
  NO_SHOW
  EXPIRED
}

enum AppointmentEventType {
  REQUESTED
  ACCEPTED
  DECLINED
  RESCHEDULE_PROPOSED
  CANCELLED
  EXPIRED
}

// Fixed reasons only: there is no free text between users before unlock.
enum ReasonCode {
  SOMETHING_CAME_UP
  TRY_ANOTHER_DAY
  REQUEST_DIFFERENT_TIME
  UNAVAILABLE_THIS_WEEK
}

enum VideoIntroStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  NO_SHOW
}

enum InterestValue {
  YES
  NO
}

enum ConciergeOrderStatus {
  PAID
  SCHEDULED
  CONSULTED
  DRAFTED
  APPROVED
  REFUNDED
}

enum ConsultationStatus {
  SCHEDULED
  HELD
  CANCELLED
}

enum ConciergeDraftStatus {
  DRAFT
  SUBMITTED
  CHANGES_REQUESTED
  APPROVED
}

enum ReportReason {
  HARASSMENT
  FAKE_PROFILE
  INAPPROPRIATE_CONTENT
  UNDERAGE
  SAFETY_CONCERN
  OTHER
}

// ---------------------------------------------------------------------------
// Auth.js (database sessions)
// ---------------------------------------------------------------------------

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------------------------------------------------------------------------
// Members
// ---------------------------------------------------------------------------

model User {
  id                 String             @id @default(cuid())
  name               String?
  email              String             @unique
  emailVerified      DateTime?
  image              String?
  role               Role               @default(MEMBER)
  // Date of birth is only ever stored when it shows 18+.
  dob                DateTime?          @db.Date
  // Set when an under-18 DOB is submitted; the DOB itself is discarded.
  ageBlockedAt       DateTime?
  verificationStatus VerificationStatus @default(PENDING)
  verificationRef    String?
  createdAt          DateTime           @default(now())

  accounts                  Account[]
  sessions                  Session[]
  profile                   Profile?
  onboarding                OnboardingProgress?
  photos                    Photo[]
  preference                Preference?
  availabilityRules         AvailabilityRule[]
  blockedTimes              BlockedTime[]
  availableNowSessions      AvailableNowSession[]
  savedProfiles             SavedProfile[]            @relation("Saver")
  savedBy                   SavedProfile[]            @relation("Saved")
  requestedAppointments     Appointment[]             @relation("Requester")
  receivedAppointments      Appointment[]             @relation("Recipient")
  appointmentParticipations AppointmentParticipant[]
  appointmentEvents         AppointmentEvent[]
  interestSent              InterestSignal[]          @relation("InterestFrom")
  interestReceived          InterestSignal[]          @relation("InterestTo")
  matchesAsA                Match[]                   @relation("MatchA")
  matchesAsB                Match[]                   @relation("MatchB")
  messages                  Message[]
  conciergeOrders           ConciergeOrder[]          @relation("OrderMember")
  consultingOrders          ConciergeOrder[]          @relation("OrderConsultant")
  auditLogs                 AuditLog[]
  reportsFiled              Report[]                  @relation("Reporter")
  reportsReceived           Report[]                  @relation("Reported")
  blocksMade                Block[]                   @relation("Blocker")
  blocksReceived            Block[]                   @relation("Blocked")
}

// Per-step persistence for the resumable onboarding wizard.
model OnboardingProgress {
  userId         String       @id
  completedSteps Int[]        @default([])
  profilePath    ProfilePath?
  completedAt    DateTime?
  updatedAt      DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Profile {
  userId      String        @id
  firstName   String?
  bio         String?
  occupation  String?
  industry    String?
  education   String?
  city        String?
  timeZone    String?
  geo         Json?
  intentions  String[]
  values      String[]
  interests   String[]
  lifestyle   String?
  wellness    String?
  familyGoals String?
  religion    String?
  status      ProfileStatus @default(DRAFT)
  authoredBy  AuthoredBy    @default(SELF)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
}

model Photo {
  id               String           @id @default(cuid())
  userId           String
  url              String
  order            Int
  isPrimary        Boolean          @default(false)
  moderationStatus ModerationStatus @default(PENDING)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, order])
}

model Preference {
  userId     String @id
  ageMin     Int
  ageMax     Int
  distanceKm Int
  filters    Json   @default("{}")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AvailabilityRule {
  id       String @id @default(cuid())
  userId   String
  weekday  Int
  startMin Int
  endMin   Int
  tz       String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model BlockedTime {
  id       String   @id @default(cuid())
  userId   String
  startsAt DateTime
  endsAt   DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// At most one active session per user (partial unique index in the migration).
model AvailableNowSession {
  id        String    @id @default(cuid())
  userId    String
  startsAt  DateTime
  expiresAt DateTime
  endedAt   DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

model SavedProfile {
  userId      String
  savedUserId String

  user      User @relation("Saver", fields: [userId], references: [id], onDelete: Cascade)
  savedUser User @relation("Saved", fields: [savedUserId], references: [id], onDelete: Cascade)

  @@id([userId, savedUserId])
}

// ---------------------------------------------------------------------------
// Scheduling & introductions
// ---------------------------------------------------------------------------

model Appointment {
  id            String            @id @default(cuid())
  requesterId   String
  recipientId   String
  startsAt      DateTime
  endsAt        DateTime
  kind          AppointmentKind   @default(SCHEDULED)
  status        AppointmentStatus @default(REQUESTED)
  roomId        String?
  holdExpiresAt DateTime?
  createdAt     DateTime          @default(now())

  requester    User                     @relation("Requester", fields: [requesterId], references: [id], onDelete: Cascade)
  recipient    User                     @relation("Recipient", fields: [recipientId], references: [id], onDelete: Cascade)
  participants AppointmentParticipant[]
  events       AppointmentEvent[]
  videoIntro   VideoIntro?

  @@index([requesterId])
  @@index([recipientId])
}

// One row per participant per appointment. The migration adds a GiST exclusion
// constraint so a user can never have two overlapping active appointments.
model AppointmentParticipant {
  id            String   @id @default(cuid())
  appointmentId String
  userId        String
  startsAt      DateTime
  endsAt        DateTime
  active        Boolean  @default(true)

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([appointmentId, userId])
}

// Structured pre-unlock communication. No free-text column by design.
model AppointmentEvent {
  id               String               @id @default(cuid())
  appointmentId    String
  actorId          String
  type             AppointmentEventType
  reasonCode       ReasonCode?
  proposedStartsAt DateTime?
  createdAt        DateTime             @default(now())

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  actor       User        @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([appointmentId])
}

model VideoIntro {
  id            String           @id @default(cuid())
  appointmentId String           @unique
  startedAt     DateTime?
  endedAt       DateTime?
  status        VideoIntroStatus @default(SCHEDULED)

  appointment Appointment      @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  signals     InterestSignal[]
}

// Private; never revealed to the other party.
model InterestSignal {
  introId    String
  fromUserId String
  toUserId   String
  value      InterestValue

  intro VideoIntro @relation(fields: [introId], references: [id], onDelete: Cascade)
  from  User       @relation("InterestFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  to    User       @relation("InterestTo", fields: [toUserId], references: [id], onDelete: Cascade)

  @@id([introId, fromUserId])
}

// Created only on mutual YES after a COMPLETED intro (policy layer, backlog #34/#39).
model Match {
  id         String   @id @default(cuid())
  userAId    String
  userBId    String
  unlockedAt DateTime @default(now())

  userA        User          @relation("MatchA", fields: [userAId], references: [id], onDelete: Cascade)
  userB        User          @relation("MatchB", fields: [userBId], references: [id], onDelete: Cascade)
  conversation Conversation?

  @@unique([userAId, userBId])
}

// Message inserts require a Conversation, which requires a Match row (FK chain).
model Conversation {
  id      String @id @default(cuid())
  matchId String @unique

  match    Match     @relation(fields: [matchId], references: [id], onDelete: Cascade)
  messages Message[]
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  senderId       String
  body           String
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

// ---------------------------------------------------------------------------
// Profile Concierge
// ---------------------------------------------------------------------------

model ConciergeOrder {
  id                    String               @id @default(cuid())
  userId                String
  stripePaymentIntentId String               @unique
  status                ConciergeOrderStatus @default(PAID)
  consultantId          String?
  createdAt             DateTime             @default(now())

  user         User                     @relation("OrderMember", fields: [userId], references: [id], onDelete: Cascade)
  consultant   User?                    @relation("OrderConsultant", fields: [consultantId], references: [id])
  consultation ConsultationAppointment?
  drafts       ConciergeDraft[]
  notes        ConsultantNote[]
}

model ConsultationAppointment {
  id       String             @id @default(cuid())
  orderId  String             @unique
  startsAt DateTime
  roomId   String?
  status   ConsultationStatus @default(SCHEDULED)

  order ConciergeOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model ConciergeDraft {
  id               String               @id @default(cuid())
  orderId          String
  profileSnapshot  Json
  selectedPhotoIds String[]
  version          Int                  @default(1)
  status           ConciergeDraftStatus @default(DRAFT)

  order ConciergeOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@unique([orderId, version])
}

// Staff-only.
model ConsultantNote {
  id      String @id @default(cuid())
  orderId String
  body    String

  order ConciergeOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Trust & safety
// ---------------------------------------------------------------------------

model AuditLog {
  id       String   @id @default(cuid())
  actorId  String
  action   String
  entity   String
  entityId String
  at       DateTime @default(now())

  actor User @relation(fields: [actorId], references: [id])

  @@index([entity, entityId])
}

model Report {
  id         String       @id @default(cuid())
  reporterId String
  reportedId String
  reason     ReportReason
  details    String?
  createdAt  DateTime     @default(now())

  reporter User @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reported User @relation("Reported", fields: [reportedId], references: [id], onDelete: Cascade)
}

model Block {
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
}
